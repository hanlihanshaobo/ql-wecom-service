# ===== 企业微信应用配置 =====
# 企业 ID：企业微信管理后台 → 我的企业 → 企业信息
WE_COM_CORP_ID=
# 应用 AgentId：企业微信管理后台 → 应用管理 → 自建应用
WE_COM_AGENT_ID=
# 应用 Secret：同上页面
WE_COM_CORP_SECRET=
# 消息加密密钥 (EncodingAESKey)：应用 → 接收消息 → 设置 API 接收
# 使用 SAFETY 加密模式时必填；明文模式可留空
WE_COM_ENCODING_AES_KEY=
# 加解密模式：SAFETY = 加密（推荐）/ NORMAL = 明文
WE_COM_ENCRYPT_MODE=SAFETY
# 企业微信 API 地址（一般无需修改；使用代理时可改）
# WE_COM_API_BASE=https://qyapi.weixin.qq.com

# ===== 回调服务器配置 =====
# 公网回调域名（填到企业微信后台，不是监听地址）
CALLBACK_HOST=https://your.domain.com
# 服务监听地址（Docker 内保持 0.0.0.0）
CALLBACK_BIND=0.0.0.0
# 服务监听端口
CALLBACK_PORT=3000
# 回调路径
CALLBACK_PATH=/wecom/callback
# 回调 Token（自定义任意字符串，与企业微信后台设置一致）
CALLBACK_TOKEN=
# 明文模式下的附加校验密钥；设置后回调 URL 需追加 ?secret=...
# 使用 SAFETY 加密模式时可留空
CALLBACK_SECRET=

# ===== 青龙面板 (QL) 配置 =====
# 青龙面板 API 地址。容器内需用宿主机 IP（Docker 网桥网关）：
#   docker network inspect bridge --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# 或直接填宿主机的内网 IP
QL_BASE_URL=http://172.20.0.1:5700
# 青龙 OAuth2 客户端 ID（青龙面板 → 系统设置 → 应用设置 → 创建应用）
QL_CLIENT_ID=
# 青龙 OAuth2 客户端 Secret
QL_CLIENT_SECRET=
# 青龙面板公网域名（仅当通过 frp/代理 访问时需要，用于设置 Host 请求头）
QL_HOST=

# ===== 命令配置 =====
# 消息触发前缀，留空则直接匹配指令；填 ql 后可发送 "ql 任务列表"（不填前缀也兼容）
BOT_PREFIX=
# 可选：允许使用机器人的企业微信 UserID，逗号分隔；留空允许所有人
BOT_ALLOWED_USERS=
# 自定义脚本：点击菜单按钮时，执行此脚本
# filename: 青龙面板中的脚本文件名，如 custom.sh
CUSTOM_SCRIPT_FILENAME=
# path: 脚本所在目录（可选），如 scripts
CUSTOM_SCRIPT_PATH=
# 菜单按钮显示名称（默认：执行自定义脚本）
CUSTOM_SCRIPT_BUTTON_NAME=执行自定义脚本
