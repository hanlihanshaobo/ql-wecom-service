# ===== 企业微信应用配置 =====
# corpid 获取地址: 企业微信管理后台 -> 我的企业 -> 基础信息
WE_COM_CORP_ID=
# 应用 ID: 企业微信管理后台 -> 应用管理 -> 你的应用 -> AgentID
WE_COM_AGENT_ID=
# 应用 Secret: 企业微信管理后台 -> 应用管理 -> 你的应用 -> 应用密钥
WE_COM_CORP_SECRET=
# 消息加密密钥 (EncodingAESKey): 创建应用时生成，明文模式留空
WE_COM_ENCODING_AES_KEY=
# 加解密模式: aes / plain
WE_COM_ENCRYPT_MODE=aes

# ===== 回调服务器配置 =====
CALLBACK_HOST=https://your.domain.com
CALLBACK_PORT=3000
CALLBACK_TOKEN=

# ===== 青龙面板 (QL) 配置 =====
# 青龙面板与回调服务不在同一台机器时，QL_BASE_URL 填宿主机上 frps 监听的 HTTP 端口
# 容器内用 host-gateway 访问宿主机（已通过 compose extra_hosts 配置）
QL_BASE_URL=http://host-gateway:8080
QL_TOKEN=
QL_CLIENT_ID=
QL_CLIENT_SECRET=
# QL_HOST 填青龙面板的公网域名，请求时加上 Host 头让 frps 正确路由
QL_HOST=ql.shaobo.xyz

# ===== 命令配置 =====
BOT_PREFIX=ql
