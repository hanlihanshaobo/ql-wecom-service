# ===== 企业微信智能机器人（API 模式 → 长连接）=====
# 企业微信管理后台 → 管理工具 → 智能机器人 → 创建机器人 → API 模式 → 长连接
# 复制页面中的 BotID 和 Secret
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_BOT_WS_URL=wss://openws.work.weixin.qq.com
# 心跳间隔（秒）
WECOM_BOT_HEARTBEAT=30
# 最大重连次数，-1 表示无限重连
WECOM_BOT_MAX_RECONNECT_ATTEMPTS=-1
# 用户首次进入机器人会话时的欢迎语
BOT_WELCOME_MESSAGE=发送「菜单」打开操作面板，或直接发送指令

# ===== 青龙面板 (QL) 配置 =====
# 青龙面板 API 地址。Docker 独立部署时需用宿主机 IP（Docker 网桥网关）：
#   docker network inspect bridge --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# 青龙机器人插件模式在同一个容器内，填 http://127.0.0.1:5700 即可
QL_BASE_URL=http://127.0.0.1:5700
# 青龙 OAuth2 客户端 ID（青龙面板 → 系统设置 → 应用设置 → 创建应用）
QL_CLIENT_ID=
# 青龙 OAuth2 客户端 Secret
QL_CLIENT_SECRET=
# 青龙面板公网域名（仅当通过 frp/代理 访问时需要，用于设置 Host 请求头）
QL_HOST=

# ===== 命令配置 =====
# 消息触发前缀，留空则直接匹配指令；填 ql 后可发送 "ql 任务列表"（不填前缀也兼容）
BOT_PREFIX=
# 可选：允许使用机器人的企业微信 UserID，逗号分隔；留空允许所有人
BOT_ALLOWED_USERS=
# 自定义脚本：发送「自定义脚本」指令时运行此脚本
# filename: 青龙面板中的脚本文件名，如 custom.sh
CUSTOM_SCRIPT_FILENAME=
# path: 脚本所在目录（可选），如 scripts
CUSTOM_SCRIPT_PATH=
# 自定义脚本的显示名称（默认：执行自定义脚本）
CUSTOM_SCRIPT_BUTTON_NAME=执行自定义脚本
