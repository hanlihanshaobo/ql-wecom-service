# ===== 企业微信应用配置 =====
# 企业 ID：企业微信管理后台 → 我的企业 → 企业信息
WE_COM_CORP_ID=
# 应用 AgentId：企业微信管理后台 → 应用管理 → 自建应用
WE_COM_AGENT_ID=
# 应用 Secret：同上页面
WE_COM_CORP_SECRET=
# 消息加密密钥 (EncodingAESKey)：应用 → 接收消息 → 设置 API 接收
# 明文模式下留空即可
WE_COM_ENCODING_AES_KEY=
# 加解密模式：NORMAL = 明文 / SAFETY = 加密
WE_COM_ENCRYPT_MODE=NORMAL

# ===== 回调服务器配置 =====
# 回调接收域名（企业微信将消息推送到此地址）
CALLBACK_HOST=https://your.domain.com
# 服务监听端口
CALLBACK_PORT=3000
# 回调 Token（自定义任意字符串，与企业微信后台设置一致）
CALLBACK_TOKEN=

# ===== 青龙面板 (QL) 配置 =====
# 青龙面板 API 地址。容器内需用宿主机 IP（Docker 网桥网关）：
#   docker network inspect bridge --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# 或直接填宿主机的内网 IP
QL_BASE_URL=http://172.20.0.1:5700
# 青龙 OAuth2 客户端 ID（青龙面板 → 系统设置 → 系统配置 → 添加应用）
QL_CLIENT_ID=
# 青龙 OAuth2 客户端 Secret
QL_CLIENT_SECRET=
# 青龙面板公网域名（仅当通过 frp/代理 访问时需要，用于设置 Host 请求头）
QL_HOST=

# ===== 命令配置 =====
# 消息触发前缀，如 "ql 任务列表"
BOT_PREFIX=ql
# 自定义脚本：点击菜单按钮时，执行此脚本
# filename: 青龙面板中的脚本文件名，如 custom.sh
CUSTOM_SCRIPT_FILENAME=
# path: 脚本所在目录（可选），如 scripts
CUSTOM_SCRIPT_PATH=
# 菜单按钮显示名称（默认：执行自定义脚本）
CUSTOM_SCRIPT_BUTTON_NAME=执行自定义脚本
